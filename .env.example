# =============================================================================
# SaveDost Frontend — Environment Configuration Template
# =============================================================================
# Note: Never commit production API keys or secrets in client-side environment files.
# The real backend URL must be confirmed before production deployment.

# Primary Backend API Base URL (Mounts at /api/v1)
REACT_APP_API_BASE_URL=http://localhost:5000/api/v1

# Environment Mode
REACT_APP_ENV=development
